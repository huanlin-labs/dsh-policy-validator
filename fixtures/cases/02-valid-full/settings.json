{
  "paused": false,
  "policy": {
    "rules": [
      {
        "id": "copy",
        "name": "Copy fixes",
        "enabled": true,
        "instruction": "Fix typos and punctuation without changing meaning."
      },
      {
        "id": "visual",
        "name": "Visual fixes",
        "enabled": true,
        "instruction": "Fix local spacing or alignment with a specified target."
      }
    ],
    "sources": {
      "github": {
        "allowed": [
          {
            "id": "alice",
            "name": "Alice"
          }
        ],
        "admission": {
          "issue": {
            "listedUnaddressed": "inferred"
          },
          "pull_request": {
            "listedUnaddressed": "inferred"
          }
        },
        "bots": [
          {
            "id": "dependabot[bot]",
            "name": "Dependabot"
          }
        ]
      }
    }
  },
  "eval": {
    "mode": "auto",
    "timeoutSeconds": 120,
    "model": null
  },
  "executor": {
    "model": null,
    "maxWorkers": 3,
    "directory": "",
    "prepare": "pnpm install --frozen-lockfile",
    "blockedCommands": [
      "npm"
    ]
  },
  "sources": {
    "github": {
      "enabled": true,
      "config": {
        "receiveAll": true
      }
    }
  }
}
