{
  "paused": true,
  "policy": {
    "rules": [
      {
        "id": "copy",
        "name": "Copy fixes",
        "enabled": true,
        "instruction": "Fix typos."
      }
    ],
    "sources": {
      "github": {
        "allowed": [{ "id": "alice" }],
        "admission": {
          "issues": { "unlistedAddressed": "explicit" }
        }
      }
    }
  },
  "eval": { "mode": "off" },
  "executor": { "blockedCommands": ["gh"] },
  "sources": {
    "github": {
      "enabled": true,
      "config": {
        "repository": "deepseek-ai/dsh-superagent-prototype",
        "cli": "gh",
        "observeIssues": true
      }
    }
  }
}
